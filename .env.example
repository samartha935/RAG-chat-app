# Copy to `.env.local` and fill in values (see docs/RAG-BUILD-PLAN.md).

DATABASE_URL=postgresql://rag_user:rag_pass@localhost:5432/rag_db

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

UPLOAD_DIR=./uploads
MAX_UPLOAD_BYTES=10485760
# Total PDF bytes per user across all documents (VPS-local storage cap)
MAX_STORAGE_BYTES_PER_USER=52428800

RATE_LIMIT_CHAT_RPM_PER_USER=3
RATE_LIMIT_CHAT_RPD_PER_USER=40
